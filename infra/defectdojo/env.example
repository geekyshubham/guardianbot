# Documentation-only example. Never deploy this file or place real secrets in Git.
COMPOSE_PROJECT_NAME=guardianbot-defectdojo
DEFECTDOJO_DOMAIN=defectdojo.example.com
CADDY_ACME_EMAIL=operator@example.com
DD_DATABASE_HOST=private-example.db.ondigitalocean.com
DD_DATABASE_PORT=25060
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=replace-with-digitalocean-user-password
DD_SECRET_KEY=replace-with-at-least-64-random-bytes
DD_CREDENTIAL_AES_256_KEY=replace-with-a-stable-random-key
DD_ADMIN_USER=guardianadmin
DD_ADMIN_MAIL=operator@example.com
DD_ADMIN_FIRST_NAME=GuardianBot
DD_ADMIN_LAST_NAME=Operator
DD_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
DD_JIRA_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
