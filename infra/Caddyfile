{$GUARDIANBOT_HOSTNAME} {
  encode zstd gzip
  log {
    output stdout
    format json
  }

  request_body {
    max_size 3MB
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  }

  # Prometheus scrapes this endpoint over the private Compose network. Do not
  # expose queue, failure, or backend-health metrics through the public edge.
  @internal_metrics path /metrics
  respond @internal_metrics 404

  reverse_proxy control-plane:3000
}
