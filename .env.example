PORT=3000
GUARDIANBOT_PUBLIC_URL=https://guardianbot.example.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GUARDIANBOT_EVIDENCE_SIGNING_SECRET=
GUARDIANBOT_TRUSTED_WORKFLOW_REPOSITORY=Geekyshubham/guardianbot
GUARDIANBOT_TRUSTED_SECURITY_WORKFLOW_SHA=
GUARDIANBOT_TRUSTED_IMAGE_WORKFLOW_SHA=
GUARDIANBOT_TRUSTED_DAST_WORKFLOW_SHA=
GUARDIANBOT_DAST_PROFILES_JSON={}
GUARDIANBOT_ALLOW_POC_STATIC_DAST=0
GUARDIANBOT_DIGITALOCEAN_DEPLOYMENTS_JSON={}
DATABASE_URL=postgresql://guardianbot:change-me@postgres:5432/guardianbot
GUARDIANBOT_DATABASE_CA_CERT=
# Preferred: administrative multi-backend registry (bridge endpoints only; no provider URLs).
# GUARDIAN_REVIEW_REGISTRY_JSON takes precedence over GUARDIAN_MODEL_BACKEND_REGISTRY.
# GUARDIAN_REVIEW_REGISTRY_JSON=
# GUARDIAN_MODEL_BACKEND_REGISTRY=
# Legacy single-backend shortcut when no registry JSON is set:
GUARDIAN_MODEL_BACKEND_URL=
GUARDIAN_MODEL_BACKEND_TOKEN=
GUARDIANBOT_METRICS_BEARER_TOKEN=
GUARDIANBOT_TRUST_PRIVATE_METRICS=0
# Terminal webhook job retention/cleanup (succeeded + dead-letter only; pending/leased never purged).
# Defaults: 7d succeeded, 30d dead-letter, 1h interval, batch 1000. Bounds fail closed at boot.
GUARDIANBOT_WEBHOOK_SUCCEEDED_RETENTION_MS=604800000
GUARDIANBOT_WEBHOOK_DEAD_LETTER_RETENTION_MS=2592000000
GUARDIANBOT_WEBHOOK_CLEANUP_INTERVAL_MS=3600000
GUARDIANBOT_WEBHOOK_CLEANUP_BATCH_LIMIT=1000
GUARDIANBOT_DEFECTDOJO_BASE_URL_REF=GUARDIANBOT_DEFECTDOJO_BASE_URL
GUARDIANBOT_DEFECTDOJO_API_TOKEN_REF=GUARDIANBOT_DEFECTDOJO_API_TOKEN
GUARDIANBOT_DEFECTDOJO_BASE_URL=https://defectdojo.example.com
GUARDIANBOT_DEFECTDOJO_API_TOKEN=
